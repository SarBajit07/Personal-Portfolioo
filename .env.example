# Server-side only. Never prefixed NEXT_PUBLIC_, never imported by a client
# component. On Vercel these are Environment Variables (Production + Preview).

RESEND_API_KEY=
CONTACT_FROM="Portfolio <portfolio@yourdomain>"
CONTACT_TO=

# Optional. With no site key the form still runs the honeypot and timing checks;
# with one, submissions are verified by Turnstile as well.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Absolute site URL, used for canonicals, OG images and the sitemap.
NEXT_PUBLIC_SITE_URL=https://sarbajit.dev
